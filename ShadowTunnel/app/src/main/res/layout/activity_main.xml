<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical" android:padding="20dp"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#0A0A0A">
    <TextView android:text="SHADOW TUNNEL" android:textColor="#00FF88" android:textSize="28sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content" />
    <TextView android:id="@+id/statusText" android:text="Déconnecté" android:textColor="#FFFFFF" android:layout_marginTop="10dp" android:layout_width="wrap_content" android:layout_height="wrap_content" />
    <EditText android:id="@+id/configInput" android:hint="Colle vmess:// ou ssh://" android:textColor="#FFFFFF" android:hintTextColor="#888888" android:layout_marginTop="20dp" android:layout_width="match_parent" android:layout_height="wrap_content" />
    <Button android:id="@+id/btnConnect" android:text="CONNECTER" android:layout_marginTop="20dp" android:layout_width="match_parent" android:layout_height="60dp" />
</LinearLayout>
